[Unit]
Description=Dachboard ttyd root shell
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/root
ExecStart=/usr/local/bin/ttyd -i 127.0.0.1 -p PORT --writable tmux -L dach-root -f /opt/dachboard/term/tmux.conf new -A -s main bash -l
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
