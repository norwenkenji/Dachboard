# Template instance: dach-ttyd-<slot>.service
# install.sh generates one static unit per slot from this template.
[Unit]
Description=Dachboard ttyd for %i
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i
ExecStart=/usr/local/bin/ttyd -i 127.0.0.1 -p PORT --writable tmux -L dach-%i -f /opt/dachboard/term/tmux.conf new -A -s main bash -l
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
